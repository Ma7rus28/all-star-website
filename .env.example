# Public address of the live site, no trailing slash (used for payment return links).
SITE_URL=

# Where quote and data-request form submissions are POSTed as JSON
# (email service, CRM, Zapier/Make webhook...). Without it, production forms
# tell visitors to contact you directly instead of pretending to send.
FORMS_WEBHOOK_URL=

# Moyasar secret key (dashboard.moyasar.com > Settings > API keys).
# Use the sk_test_... key until you are ready to take real payments.
# Never commit the real value: put it in .env.local or your host's settings.
MOYASAR_SECRET_KEY=

# Code from Google Search Console (Settings > Ownership verification > HTML tag), content value only.
GOOGLE_SITE_VERIFICATION=
