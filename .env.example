# Public address of the live site, no trailing slash (canonical links, sitemap).
SITE_URL=

# Where quote and data-request form submissions are POSTed as JSON
# (email service, CRM, Zapier/Make webhook...). Without it, production forms
# tell visitors to contact you directly instead of pretending to send.
FORMS_WEBHOOK_URL=

# Code from Google Search Console (Settings > Ownership verification > HTML tag), content value only.
GOOGLE_SITE_VERIFICATION=
